<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background: the same accent gradient as `bg-accent-grad` in
    tailwind.config.js, so the launcher tile matches the mark in the app header.

    Full-bleed 108x108 with square corners on purpose — the launcher supplies
    the mask (circle, squircle, teardrop, …) and rounding it here too would
    show as a dark seam inside whatever shape the device picks.

    The diagonal start/end reproduces CSS `linear-gradient(135deg, …)`: top-left
    to bottom-right. Multi-stop vector gradients need API 24, which is our
    minSdkVersion, and adaptive icons only apply from API 26, so this always
    renders.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF6366F1" />
                <item android:offset="0.5" android:color="#FF8B5CF6" />
                <item android:offset="1.0" android:color="#FFD946EF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
